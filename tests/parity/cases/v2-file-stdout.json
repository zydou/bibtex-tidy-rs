{
  "name": "v2-file-stdout",
  "args": [
    "--v2",
    "in.bib"
  ],
  "stdin": null,
  "files": {
    "in.bib": "@article{a,\n  TITLE = {Hello World},\n  author = {Smith, John},\n  year = {2020}\n}\n"
  },
  "env": {
    "PRE_COMMIT": "1"
  },
  "match": "full",
  "expected": {
    "stdout": "@article{a,\n  title         = {Hello World},\n  author        = {Smith, John},\n  year          = {2020}\n}\n",
    "stderr": "",
    "exit": 0,
    "files": {
      "in.bib": "@article{a,\n  TITLE = {Hello World},\n  author = {Smith, John},\n  year = {2020}\n}\n"
    }
  }
}
