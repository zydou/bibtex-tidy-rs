{
  "name": "backup-without-modify-v2",
  "args": [
    "--v2",
    "--backup",
    "in.bib"
  ],
  "stdin": null,
  "files": {
    "in.bib": "@article{a,\n  TITLE = {Hello World},\n  author = {Smith, John},\n  year = {2020}\n}\n"
  },
  "env": {
    "PRE_COMMIT": "1"
  },
  "match": "full",
  "expected": {
    "stdout": "",
    "stderr": "--backup is only permitted when --modify/-m is provided\n",
    "exit": 1,
    "files": {
      "in.bib": "@article{a,\n  TITLE = {Hello World},\n  author = {Smith, John},\n  year = {2020}\n}\n"
    }
  }
}
